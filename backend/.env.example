GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash-lite
GOOGLE_AI_TIMEOUT_SECONDS=30
GOOGLE_AI_THINKING_BUDGET=0
MONGODB_URI=
MONGODB_DATABASE=rescueme
MONGODB_LIVE_INCIDENTS_COLLECTION=live_incidents
MONGODB_TIMEOUT_MS=2500
LIVE_INCIDENTS_USER_AGENT=RescueMe/0.1 live incident importer

# Security hardening for public deployments. Leave blank for local classroom demos.
RESCUEME_PUBLIC_MODE=false
RESCUEME_ADMIN_TOKEN=
RESCUEME_RESPONDER_TOKEN=
RESCUEME_CORS_ORIGINS=
RESCUEME_CORS_ORIGIN_REGEX=
RESCUEME_REQUIRE_HTTPS=false
RESCUEME_DISABLE_RATE_LIMITING=false
